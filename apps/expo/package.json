{
  "name": "@startracker/expo",
  "version": "0.1.0",
  "private": true,
  "main": "index.tsx",
  "scripts": {
    "clean": "git clean -xdf .expo .turbo node_modules",
    "start": "expo start --web",
    "dev:web": "expo start --web",
    "dev:prod": "EXPO_PUBLIC_ENV=production expo start --ios",
    "dev": "EXPO_PUBLIC_ENV=development expo start --ios",
    "dev:android": "EXPO_PUBLIC_ENV=production EXPO_PUBLIC_API_URL=https://startracker.vercel.app expo start --android",
    "dev:ios": "EXPO_PUBLIC_ENV=production EXPO_PUBLIC_API_URL=https://startracker.vercel.app expo start --ios",
    "start:android": "EXPO_PUBLIC_ENV=production EXPO_PUBLIC_API_URL=https://startracker.vercel.app expo run:android --device",
    "start:ios": "EXPO_PUBLIC_ENV=production EXPO_PUBLIC_API_URL=https://startracker.vercel.app expo run:ios --device",
    "build:web": "node scripts/generate-pwa-icons.js && expo export -p web && node scripts/inject-pwa.js && npx workbox generateSW workbox-config.js",
    "serve:pwa": "node serve-pwa.js",
    "generate:icons": "node scripts/generate-pwa-icons.js",
    "setup:oauth": "node scripts/setup-oauth-urls.js",
    "lint": "eslint .",
    "lint:fix": "pnpm lint --fix",
    "type-check": "tsc --noEmit",
    "eas:update:prod": "EXPO_PUBLIC_ENV=production npx eas update --branch=production",
    "eas:update:main": "EXPO_PUBLIC_ENV=production npx eas update --branch=main",
    "eas:update:staging": "EXPO_PUBLIC_ENV=development EXPO_PUBLIC_API_URL=https://startracker-staging.vercel.app npx eas update --channel=staging",
    "eas:build": "EXPO_PUBLIC_ENV=production EXPO_PUBLIC_API_URL=https://startracker.vercel.app npx eas build",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
